# eero Dashboard — Backend Environment Variables
# Copy to .env and adjust for local development.

# Dry-run mode: intercepts mutation API calls with mock responses.
# Safe mutations (settings, SQM, DNS, guest network, pause device) return
# mock data. Unsafe mutations (reboot, profiles, blacklist, etc.) are blocked.
# See CONTRIBUTING.md for the full endpoint table.
# NEVER enable in production.
EERO_DRY_RUN=false

# Speed test configuration
# SPEED_HISTORY_DAYS=365
# SPEED_TEST_POLL_INTERVAL=10
# SPEED_TEST_TIMEOUT=120
